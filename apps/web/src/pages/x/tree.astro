---
// Projektor X: issue hierarchy of the current project. Tab registered in src/x/nav.ts.
import Base from '../../layouts/Base.astro';
import ProjectNav from '../../islands/ProjectNav';
import IssueTree from '../../islands/x/IssueTree';

const workspaceSlug = import.meta.env.PUBLIC_WORKSPACE_SLUG as string | undefined;
---
<Base title="Tree — Projektor">
  <ProjectNav client:load workspaceSlug={workspaceSlug} pageLabel="Tree" />
  <div class="page-container">
    <header style="margin-bottom: 1.5rem;">
      <h1 style="margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--text);">Tree</h1>
    </header>
    <IssueTree client:load workspaceSlug={workspaceSlug} />
  </div>
</Base>
